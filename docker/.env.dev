# Development profile for docker/docker-compose.full.yml (the default).
# Plain KEY=VALUE lines only, comments on their own lines (Docker's env-file parser). No secrets
# belong here: this file is committed.
#
# These variables override configs/config.yaml (see ENV_OVERRIDES in src/utils/config.py).

# --- General ------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=DEBUG
# console = readable `docker compose logs`; prod uses json for log shippers.
LOG_FORMAT=console

# --- Simulation ---------------------------------------------------------------
# 10x fast-forward: anomalies show up in the dashboard within minutes.
SIMULATION_SPEED=10
SIMULATION_SEED=42

# --- Kafka --------------------------------------------------------------------
# Inside the compose network the broker is kafka:29092 (localhost:9092 is for the host).
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP_ID=anomaly-detector

# --- Services -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# How the dashboard *server* reaches the API (container to container) ...
API_URL=http://api:8000
# ... and how the *browser* reaches it for the live alert stream (SSE).
PUBLIC_API_URL=http://localhost:8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
# API_ADMIN_KEY is not set here: export it in your shell if you want the admin endpoints protected.

# --- Storage (named volumes mounted by the compose file) -----------------------
MODEL_REGISTRY_DIR=/app/models
FEEDBACK_STORE_PATH=/app/data/feedback/feedback_store.json
ANOMALY_SNAPSHOT_DIR=/app/data/snapshots

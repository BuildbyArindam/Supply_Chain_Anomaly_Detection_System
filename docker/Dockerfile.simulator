# Simulator image: streams simulated warehouse / GPS / inventory events into Kafka.
# Build from the project root:
#   docker build -f docker/Dockerfile.simulator -t scad-simulator .
#
# Only the simulation and Kafka-producer dependencies are installed (no torch, scikit-learn or
# web frameworks), so the image stays small. It runs until stopped (SIGTERM flushes the producer);
# SIMULATION_SPEED and SIMULATION_SEED come from the environment.

# ---------------------------------------------------------------------------
# Stage 1: builder
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build
COPY docker/requirements-simulator.txt requirements.txt
RUN pip install -r requirements.txt

# ---------------------------------------------------------------------------
# Stage 2: runtime
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 1000 appuser

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=appuser:appuser src ./src
COPY --chown=appuser:appuser configs ./configs
COPY --chown=appuser:appuser scripts/start_simulation.py ./scripts/

USER appuser

# No HEALTHCHECK: the process has no port. It exits non-zero when Kafka is unreachable, and the
# compose restart policy (on-failure) brings it back.
CMD ["python", "-m", "src.main", "simulate"]

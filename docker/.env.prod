# Production profile for docker/docker-compose.full.yml:
#   ./scripts/docker-start.sh prod
# Plain KEY=VALUE lines only, comments on their own lines (Docker's env-file parser). This file is
# committed, so never put secrets in it. To protect the model reload/promote endpoints, export
# API_ADMIN_KEY in your shell: the compose file passes it to the api and dashboard services.
#   API_ADMIN_KEY=<long random string> ./scripts/docker-start.sh prod
#
# These variables override configs/config.yaml (see ENV_OVERRIDES in src/utils/config.py).

# --- General ------------------------------------------------------------------
APP_ENV=prod
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Simulation ---------------------------------------------------------------
# Real time: one reading per sensor per second.
SIMULATION_SPEED=1
SIMULATION_SEED=42

# --- Kafka --------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP_ID=anomaly-detector

# --- Services -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://api:8000
# Must be an address the browser can reach. On a remote host replace localhost with its name,
# and add the dashboard's origin to api.cors_origins in configs/config.yaml.
PUBLIC_API_URL=http://localhost:8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050

# --- Storage (named volumes mounted by the compose file) -----------------------
MODEL_REGISTRY_DIR=/app/models
FEEDBACK_STORE_PATH=/app/data/feedback/feedback_store.json
ANOMALY_SNAPSHOT_DIR=/app/data/snapshots

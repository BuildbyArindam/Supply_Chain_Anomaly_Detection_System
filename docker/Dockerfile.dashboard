# Dash dashboard image. Build from the project root:
#   docker build -f docker/Dockerfile.dashboard -t scad-dashboard .
#
# The dashboard reads everything from the API over HTTP (API_URL), so this image needs neither
# PyTorch nor a Kafka client. The browser opens its live-alert stream (SSE) directly on the API:
# set PUBLIC_API_URL to an address the *browser* can reach (default http://localhost:8000).
#
#   docker run --rm -p 8050:8050 -e API_URL=http://host.docker.internal:8000 scad-dashboard

# ---------------------------------------------------------------------------
# Stage 1: builder
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build
COPY docker/requirements-dashboard.txt requirements.txt
RUN pip install -r requirements.txt

# ---------------------------------------------------------------------------
# Stage 2: runtime
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DASHBOARD_HOST=0.0.0.0 \
    DASHBOARD_PORT=8050 \
    API_URL=http://api:8000

RUN useradd --create-home --uid 1000 appuser

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=appuser:appuser src ./src
COPY --chown=appuser:appuser configs ./configs
COPY --chown=appuser:appuser scripts/healthcheck.py ./scripts/

USER appuser
EXPOSE 8050

# The dashboard keeps serving (with an "Offline" badge) while the API is down, so this probes the
# dashboard process only; compose makes it wait for a healthy API before starting.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD ["python", "scripts/healthcheck.py", "http://127.0.0.1:8050/"]

CMD ["python", "-m", "src.main", "dashboard"]

# Copy to .env (`make setup` does this for you). Never commit .env.
# Every variable is optional: values here override configs/config.yaml.
# Leave a variable empty or delete it to fall back to the YAML value.

# --- General ------------------------------------------------------------------
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                  # json | console
SERVICE_NAME=scad
# CONFIG_PATH=configs/config.yaml

# --- Kafka --------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=anomaly-detector

# --- Simulation ---------------------------------------------------------------
SIMULATION_SPEED=1.0             # 1 = real time, 10 = 10x fast-forward
SIMULATION_SEED=42

# --- Services -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://localhost:8000    # used by the dashboard server to reach the API
# PUBLIC_API_URL=http://localhost:8000  # API URL as the *browser* sees it (SSE); default: API_URL
# API_ADMIN_KEY=                 # when set, model reload/promote endpoints need an X-API-Key header
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
PROMETHEUS_PORT=9090

# --- Storage ------------------------------------------------------------------
MODEL_REGISTRY_DIR=model_registry
# FEEDBACK_STORE_PATH=feedback_store.json   # analyst feedback (a file)
# ANOMALY_SNAPSHOT_DIR=anomaly_snapshots    # alert snapshots (a directory)
